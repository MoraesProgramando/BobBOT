# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# O .env real fica fora do Git e nunca deve ser enviado ao repositório.

# Token do bot — Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=cole_seu_token_aqui

# ID do canal de boas-vindas (clique direito no canal > Copiar ID)
CANAL_BOAS_VINDAS=000000000000000000

# Opcional: canal das novidades (sem isso o bot usa o padrão do código)
CANAL_NOVIDADES=000000000000000000

# Opcional: IDs dos cargos isentos do automod, separados por vírgula
AUTOMOD_ISENTOS=000000000000000000,000000000000000001
